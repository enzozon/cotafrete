# credenciais — NUNCA commitar
.env
*.pem
*.key

# evidências de execução (contêm CNPJ, valores de NF, screenshots)
runs/
teste_real/
*.xlsx
!tests/fixtures/*.xlsx

# recon (pode conter nonce/token de sessão)
recon_out/

# python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# backup do banco: mesmo conteudo do cotafrete.db, ou seja CNPJ de
# cliente e valor de nota fiscal. Commitar um seria vazar o historico
# inteiro de uma vez.
backup/

# log do servidor da rede. Mesmo motivo de runs/ e backup/: o traceback de
# uma transportadora que quebrou no meio da cotacao sai com o payload
# junto — CNPJ do cliente, valor da nota, endereco de entrega.
log/

# so
.DS_Store
.cache/
# atalho do Windows — entra por arrasto acidental, nao pertence ao repositorio
*.lnk
cotafrete.db
# arquivos que o modo WAL cria ao lado do banco
cotafrete.db-wal
cotafrete.db-shm
# prints gerados pelo tests/test_rebranding_visual.py a cada rodada
docs/rebranding/

# cruzamento de NF: os arquivos de verdade tem e-mail de requisitante,
# CNPJ e valor de venda. So o exemplo (dados ficticios) entra no git.
cruzar_nf/entrada/
PEDIDOS*.json
comparar.json
RELATORIO_NF.*
!cruzar_nf/exemplo/*
