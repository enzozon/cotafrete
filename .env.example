# Copie para .env e preencha. O .env está no .gitignore — não commite.

# ---- Jadlog (API oficial) --------------------------------------------
# Token emitido pela franquia Jadlog que atende seu CNPJ, mediante contrato.
JADLOG_TOKEN=
JADLOG_CONTA=
JADLOG_CONTRATO=
JADLOG_URL=https://www.jadlog.com.br/embarcador/api/frete/valor

# ---- Della Volpe (automação de formulário) ---------------------------
# Trava de segurança: sem "sim", o adapter recusa envio real.
DV_ENVIO_REAL_AUTORIZADO=nao

# ---- E-mail de saída --------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ---- Ingestor IMAP (retorno das cotações) -----------------------------
# Use uma caixa DEDICADA só para cotações.
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
